{
  "name": "chat-app",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "moon build --target js && moobile-host build",
    "start": "npm run build && expo start",
    "android": "npm run build && expo run:android",
    "ios": "npm run build && expo run:ios",
    "web": "npm run build && expo start --web",
    "regen": "moobile-host regen",
    "libgen": "node ../../../npm/moobile-host/bin/cli.js libgen",
    "libgen:check": "node ../../../npm/moobile-host/bin/cli.js libgen --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.24",
    "expo-sqlite": "~57.0.3",
    "moobile-host": "file:../../../npm/moobile-host",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-web": "^0.21.2"
  }
}
