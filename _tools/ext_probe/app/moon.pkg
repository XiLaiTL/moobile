supported_targets = "+js"

import {
  // ⚠️ 库本体是 `moobile/moobile/moobile`（模块名 + 目录名）。
  //    `moobile/moobile`（少一段）是**模块根包**，里面没有 `mount`。
  "moobile/moobile/moobile" @moobile,
  // ★ T0.0 从 internal/style 提出来的公开包：使用者写视图的入口
  "moobile/moobile/style",
  "moobile/moobile/html",
  "moobile/moobile/cmd",
}
