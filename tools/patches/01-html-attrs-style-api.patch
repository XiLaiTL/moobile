+/// 合并一份**类型化**样式 —— 这是唯一的结构化样式入口。
+///
+/// ★ moobile 改造：原来的 `Attrs::style(key : String, value : String)` 已删除。
+/// 理由有两条，都有实测支撑：
+///
+/// 1. 字符串通道让 `fontWeight`（RN 要字符串）与 `fontSize`（RN 要数字）
+///    在编译期无法区分，只能靠运行时白名单兜（见 README 的 F3）。
+/// 2. 它**零调用点** —— 唯一真实应用 `interest/yi` 从未用过结构化样式
+///    （136 处 `class=` / 0 处 `style=`），所以删掉不破坏任何代码。
+pub fn Attrs::styles(self : Attrs, s : @style.Style) -> Attrs {
+  for entry in s.entries() {
+    self.0.styles[entry.0] = entry.1
+  }
   self
 }
 
