+/// 空表。
+pub fn[V] PropsTable::new() -> PropsTable[V] {
+  { entries: @hashmap.HashMap::new() }
+}
+
+///|
+/// 索引赋值 —— 接住上游 `self.0.attrs["name"] = value` 那种写法（约 200 处）。
+#alias("_[_]=_")
+pub fn[V] PropsTable::set(self : PropsTable[V], key : String, value : V) -> Unit {
+  self.entries = self.entries.add(key, value)
+}
+
+///|
+pub fn[V] PropsTable::get(self : PropsTable[V], key : String) -> V? {
+  self.entries.get(key)
+}
+
+///|
+pub fn[V] PropsTable::contains(self : PropsTable[V], key : String) -> Bool {
+  self.entries.contains(key)
+}
+
+///|
+pub fn[V] PropsTable::remove(self : PropsTable[V], key : String) -> Unit {
+  self.entries = self.entries.remove(key)
+}
+
+///|
+pub fn[V] PropsTable::length(self : PropsTable[V]) -> Int {
+  self.entries.length()
+}
+
+///|
+pub fn[V] PropsTable::is_empty(self : PropsTable[V]) -> Bool {
+  self.entries.length() == 0
+}
+
+///|
+pub fn[V] PropsTable::iter2(self : PropsTable[V]) -> Iter2[String, V] {
+  self.entries.iter2()
+}
 
