import {
  "XiLaiTL/moobile/cmd",
  "XiLaiTL/moobile/dom",
  "XiLaiTL/moobile/url",
  "moonbitlang/async",
  "moonbitlang/async/http" @async_http,
  "moonbitlang/async/io",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "XiLaiTL/moobile/internal/key",
} for "wbtest"

warnings = "-unused_package"

supported_targets = "js+native+wasm"

options(
