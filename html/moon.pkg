import {
  "XiLaiTL/moobile/style",
  "XiLaiTL/moobile/internal/vdom",
  "XiLaiTL/moobile/dom",
  "XiLaiTL/moobile/common",
  "XiLaiTL/moobile/cmd",
  "XiLaiTL/moobile/variant",
  "moonbitlang/core/debug",
  "moonbitlang/core/ref",
