+///|
+/// ⚠️ **仍然是 O(N)**（core 的不可变表没有 O(1) 的 size）—— 别把它放进"每元素每帧"的路径。
+/// 要问"空不空"请用 `is_empty()`。
+pub fn[V] PropsTable::length(self : PropsTable[V]) -> Int {
+  self.entries.length()
+}
+
+///|
+/// **O(1)**（见 `nonempty` 字段的注释）。
+pub fn[V] PropsTable::is_empty(self : PropsTable[V]) -> Bool {
+  !self.nonempty
+}
+
+///|
+pub fn[V] PropsTable::iter2(self : PropsTable[V]) -> Iter2[String, V] {
+  self.entries.iter2()
+}
