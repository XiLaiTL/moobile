import {
  "XiLaiTL/moobile/internal/vdom",
  "XiLaiTL/moobile/dom",
  "XiLaiTL/moobile/common",
  "XiLaiTL/moobile/cmd",
  "XiLaiTL/moobile/sub",
  "moonbitlang/core/queue",
  "moonbitlang/core/json",
  "moonbitlang/async/js_async",
  "moonbitlang/async",
  "XiLaiTL/moobile/internal/key",
  "XiLaiTL/moobile/internal/any",
  "XiLaiTL/moobile/internal/slotmap",
  "XiLaiTL/moobile/internal/duplix",
}

warnings = "-unused_package"

supported_targets = "js+native+wasm"

options(
  targets: {
    "host_browser.mbt": [ "js" ],
    "host_hydration.mbt": [ "js" ],
    "host_ssr.mbt": [ "wasm", "native" ],
    "react_host.mbt": [ "js" ],
  },
)
