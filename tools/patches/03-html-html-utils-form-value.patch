+
+///|
+/// ★ moobile 扩展：从"输入事件"里取表单值的**可替换策略**。
+///
+/// 为什么需要它：rabbita 原本把 DOM 语义写死了 —— 从事件对象上
+/// `event.currentTarget` / `event.target` 再 `.value` 取值。
+/// 但 React Native 的 `TextInput` 回调（`onChangeText`）**直接给字符串**，
+/// 压根不存在 DOM 事件对象。于是这一步必须可替换：
+/// DOM 后端保持原样，React 后端把它换成"事件槽位里装的就是文本"。
+///
+/// **换掉这一个函数，`on_input=emit.map(SetDraft)` 就能在 RN 上原样工作** ——
+/// 也就是 yi 那种视图代码不需要改。这是 fork 换来的第二处实质收益。
+///
+/// ★ 参数类型是后端无关的 `Event`（不再是 `@dom.Event`）——
+/// DOM 实现自己负责在内部转回 `@dom.Event`。
+pub let form_value_from_event : Ref[(Event) -> String] = Ref(dom_form_value)
+
+///|
+/// 取表单值，走可替换策略。
+fn current_form_value(event : Event) -> String {
+  (form_value_from_event.val)(event)
+}
+
+///|
+/// DOM 默认实现：转回 `@dom.Event` 后走原来的解析。
+#cfg(target="js")
+fn dom_form_value(event : Event) -> String {
+  form_event_value(@vdom.as_dom_event(event))
 }
 
 ///|
