+///|
+/// **样式表：扁平数组**（moobile 改造，2026-10-03）。
+///
+/// ## 为什么不再用 `PropsTable`（不可变 HAMT）
+///
+/// 这条路**每个元素每帧**要插 4 条样式（N=1000 时 4005 次/帧），而 HAMT 的 `add` 每次都要
+/// **哈希 + 路径拷贝 + 分配**。消融探针（把"插入"做 3 遍、输出逐项不变）实测
+/// `min` **+61.4%（区间不重叠）** ⇒ 反推现存那一遍约 **1.8 ms/帧 ≈ 翻译层的 30%**（`PERF.md` §12.3）。
+/// ⚠️ 同一处的 profile 份额只报 3.2% —— **profile 估大小会低一个数量级**。
+///
+/// 换成数组之后：写入 = 一次数组拷贝（没有哈希），读取/迭代 = 顺序扫，`is_empty` = O(1)。
+/// 表的规模在这里天然很小（一条 `Style` 几条到十几条），所以线性扫描比哈希更快。
+///
+/// ## 三条不变式（`Props::copy` 的 O(1) 与"副本独立"全靠它们）
+///
+/// 1. **`entries` 指向的那个数组永不原地修改** —— 所有"改"都**换成新数组**。
+///    所以两个句柄可以安全共享同一个数组。
+///    ⚠️ 这条是**约定**，不是类型保证：曾试过用 `ArrayView` 把它变成类型保证，
+///    实测**更慢 8~15%**（§14.2）⇒ 留在约定这一侧，靠"不留可变别名的访问器"+ 测试守着。
+/// 2. **句柄本身是可变的**（`mut` 字段 ⇒ `Styles` 是引用类型），
+///    这样 `Props::styles()` 才能像原来那样"就地"把新样式写进这一格；
+///    而 `Props::copy()` 走 `share()` 给**新句柄** ⇒ 副本怎么改都碰不到原件。
+///    （⚠️ 这正是 `PropsTable` 第一版栽过的地方：句柄共享 + 原地改 = 串味。）
+/// 3. **存进来的数组是从调用方复制来的**：`@style.Style` 的构造器是**可变**的，
+///    调用方之后继续用那份 `Style`，不能影响这里已经存下的内容。
+pub struct Styles {
+  /// ⚠️ **裸 `Array`，不是 `ArrayView`** —— 试过后者（让"只读"由类型保证）：
+  /// 实测 `translate` **+10~15%**、`dom` **+8~9.5%**（六个统计量方向一致，堆增量 dom +86%）
+  /// ⇒ **回退**。见 `docs/PERF.md` §14.2。
+  /// 换来的安全收益用另一条路拿：**不给任何会漏出这个可变数组的访问器**
+  /// （`Styles::entries()` 已删掉），不变式 + 下面的测试守着它。
+  mut entries : Array[(String, @style.StyleValue)]
+}
+
+///|
+/// 空样式表。
+pub fn Styles::empty() -> Styles {
+  { entries: [] }
+}
+
+///|
+/// 从应用给的 `Style` 复制一份（不变式 3）。
+pub fn Styles::from_style(s : @style.Style) -> Styles {
+  { entries: s.entries().copy() }
+}
+
+///|
+/// **新句柄、同一个数组** —— `Props::copy()` 用它。
+///
+/// 之所以安全：写入一律**换新数组**（不变式 1），所以两个句柄永远不会互相看见对方的改动。
+pub fn Styles::share(self : Styles) -> Styles {
+  { entries: self.entries }
+}
+
+///|
+/// 就地合并一份样式（**后来的赢**，与原来的 HAMT 覆盖语义一致）。
+///
+/// 只改**本句柄**那一格；那个数组本身不动（不变式 1）。
+pub fn Styles::apply(self : Styles, s : @style.Style) -> Unit {
+  let incoming = s.entries()
+  if incoming.length() == 0 {
+    return
+  }
+  // ★ 快路径：表本来就是空的（**新建元素时就是这种情况**）⇒ 直接拿 incoming 的副本，不必走通用路径。
+  if self.entries.length() == 0 {
+    self.entries = incoming.copy()
+    return
+  }
+  // 通用路径：先把自己这份拷成**新数组**（`out` 是局部量，函数返回后没人持有这个旧数组的别名），
+  // 再把 incoming 合进去（同键**后来的赢**，与原来 HAMT 覆盖的语义一致），最后整体换上去。
+  let out : Array[(String, @style.StyleValue)] = self.entries.copy()
+  for entry in incoming {
+    let mut replaced = false
+    for i = 0; i < out.length(); i = i + 1 {
+      if out[i].0 == entry.0 {
+        out[i] = entry
+        replaced = true
+        break
+      }
+    }
+    if !replaced {
+      out.push(entry)
+    }
+  }
+  self.entries = out
+}
+
+///|
+/// **O(1)**（数组长度）。
+pub fn Styles::is_empty(self : Styles) -> Bool {
+  self.entries.length() == 0
+}
+
+///|
+pub fn Styles::length(self : Styles) -> Int {
+  self.entries.length()
+}
+
+///|
+/// 线性扫描：表很小（≤ 十几条），比哈希更快。
+pub fn Styles::get(self : Styles, key : String) -> @style.StyleValue? {
+  for entry in self.entries {
+    if entry.0 == key {
+      return Some(entry.1)
+    }
+  }
+  None
+}
+
+///|
+pub fn Styles::contains(self : Styles, key : String) -> Bool {
+  for entry in self.entries {
+    if entry.0 == key {
+      return true
+    }
+  }
+  false
+}
+
+///|
+/// **热路径用的按序号取**（`styles_to_js` 每帧要遍历 4005 条）。
+///
+/// 为什么不直接用 `for k, v in styles`（`iter2`）：那一条走的是**闭包迭代器**
+/// —— 每个元素都要一次间接调用 + 一个 `Option[(K,V)]`。含时归因（`PERF.md` §14.5）里
+/// `Iter2::next` 在 `styles_to_js` 下就占 1.3~2.4%，而这条按序号循环是纯索引。
+/// （仍然只读：`at` 返回的是值，拿不到那个数组。）
+pub fn Styles::at(self : Styles, i : Int) -> (String, @style.StyleValue) {
+  self.entries[i]
+}
+
+///|
+pub fn Styles::iter2(self : Styles) -> Iter2[String, @style.StyleValue] {
+  let mut i = 0
+  let n = self.entries.length()
+  Iter2::new(
+    () => {
+      guard i < n else { None }
+      let entry = self.entries[i]
+      i += 1
+      Some((entry.0, entry.1))
+    },
+    size_hint=n,
+  ).iter2()
+}
 
