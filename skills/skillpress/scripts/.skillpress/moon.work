// 工作区：把**站点实例**与**引擎包**连起来，让实例直接吃本地源码（未发布也能编）。
//
// 成员路径是**相对**的 —— 与这个工程里其它跨仓库引用同一套约定
// （`package.json` 的 `SKILLPRESS_ENGINE:-../../../../../skillpress`、
//  `verify.mjs` 的 `../../../skillpress/lib/verify-site.mjs`）：
// 前提是 `interest/skillpress` 与 `interest/moobile` 是**兄弟**目录。
members = [
  ".",
  "../../../../../skillpress",
  // ⚠️ **本地 moobile 源码**（2026-10-07 加）：站点的界面（`shell/`）用了 moobile 的
  //    节点寻址 / 容器级滚动订阅 / `Style::transform` / `copy_text`，而那几个 API
  //    **还没发布** —— 只吃 registry 上那份 0.5.0 会编不过（`Style has no method transform`）。
  //    `../../../..` 就是**这个仓自己的根**（内容仓 = moobile）⇒ 内容侧改库立刻在这里生效。
  //    等 moobile 发出带这些 API 的版本之后：抬 `moon.mod` 里的版本锚点，然后删掉这一条。
  "../../../..",
]
